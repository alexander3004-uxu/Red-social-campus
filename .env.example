# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Servidor Backend Express & WebSockets
PORT=4000
REDIS_URL="redis://127.0.0.1:6379"
CLIENT_ORIGIN="http://localhost:3000"

# Seguridad y Autenticación
JWT_SECRET="campus_super_secret_jwt_key_2026"
JWT_REFRESH_SECRET="campus_super_secret_refresh_jwt_key_2026"
COOKIE_SECRET="campus_cookie_signer_secret_key_2026"
GOOGLE_CLIENT_ID="campus-google-oauth-client-id.apps.googleusercontent.com"

# Base de datos (Opcional - Si no se especifica o está inactiva, se usa el almacén persistente en memoria)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/red_social_campus"
