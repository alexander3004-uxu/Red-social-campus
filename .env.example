# ==============================================================================
# RED SOCIAL CAMPUS - VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# ==============================================================================

# GEMINI_API_KEY: Requerida para funciones de IA Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Servidor Backend Express & WebSockets
PORT=4000
REDIS_URL="redis://127.0.0.1:6379"
CLIENT_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"

# Seguridad y Autenticación
JWT_SECRET="campus_super_secret_jwt_key_2026"
JWT_REFRESH_SECRET="campus_super_secret_refresh_jwt_key_2026"
COOKIE_SECRET="campus_cookie_signer_secret_key_2026"
GOOGLE_CLIENT_ID="campus-google-oauth-client-id.apps.googleusercontent.com"

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# 1. URL de tu proyecto en Supabase (Project Settings -> API)
VITE_SUPABASE_URL="https://skmzzjsdxwywxwemaesy.supabase.co"
SUPABASE_URL="https://skmzzjsdxwywxwemaesy.supabase.co"

# 2. Clave pública anónima (Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY="TU_SUPABASE_ANON_KEY"
SUPABASE_ANON_KEY="TU_SUPABASE_ANON_KEY"

# 3. Clave de servicio de administrador (Project Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY="TU_SUPABASE_SERVICE_ROLE_KEY"

# 4. Cadena de conexión PostgreSQL directa de Supabase (Project Settings -> Database -> Connection String)
DATABASE_URL="postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
ENABLE_POSTGRES="false"
